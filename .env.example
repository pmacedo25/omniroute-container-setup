# O instalador cria .env automaticamente e preserva os valores nas reexecuções.
OMNIROUTE_VERSION=3.8.48
OMNIROUTE_API_KEY=
OMNIROUTE_SKILLS_REPO=https://github.com/pmacedo25/project-agents-templates.git
OMNIROUTE_SKILLS_BRANCH=main
PORT=20128
OPENHANDS_PORT=3000
OPENHANDS_VERSION=1.7
OPENHANDS_AGENT_SERVER_TAG=1.19.1-python
PROJECTS_DIR=
OPENHANDS_HOME_DIR=
# Montagens adicionais do sandbox; o instalador inclui o workspace automaticamente.
SANDBOX_VOLUMES=
# Importado silenciosamente do GitHub CLI local quando já autenticado.
GITHUB_TOKEN=
CONTAINER_SOCKET=/var/run/docker.sock
SKILLS_SYNC_INTERVAL_SECONDS=3600
ACHILLES_REPOSITORY=pmacedo25/Achilles-Releases
ACHILLES_VERSION=latest
